{
  "$note": "Duo v2 design tokens, read from the approved design-canvas boards (2026-10-03). Points; 1 px on the boards = 1 pt. See README.md §4. Use semantic names in code.",
  "color": {
    "light": {
      "ground": {
        "value": "#F3F4F6",
        "use": "Toolbar, sheet backgrounds"
      },
      "pane": {
        "value": "#FFFFFF",
        "use": "Light panes, cards, popover, buttons"
      },
      "selected": {
        "value": "#E9ECEF",
        "use": "Selected row, Claude's-additions block"
      },
      "rule": {
        "value": "#C9CDD3",
        "use": "Pane dividers, card borders, field border"
      },
      "controlEdge": {
        "value": "#8B939C",
        "use": "Button and pill borders, dashed borders, group rule, files rule"
      },
      "text": {
        "value": "#1F2328",
        "use": "Primary text; review and working glyphs; selected-card border"
      },
      "text2": {
        "value": "#5B636D",
        "use": "Secondary text; idle and resolved glyphs; chevrons"
      },
      "needsYou": {
        "value": "#C2410C",
        "use": "The one accent: needs-you glyph, label, chip, question box"
      },
      "onNeedsYou": {
        "value": "#FFFFFF",
        "use": "Text and glyph on the open (filled) chip"
      },
      "placeholderBar": {
        "value": "#D5D9DE",
        "use": "Placeholder in the targets; not built"
      },
      "placeholderBarOnSelected": {
        "value": "#C3C8CE",
        "use": "Placeholder in the targets; not built"
      },
      "scrim": {
        "value": "#1F2328",
        "alpha": 0.32,
        "use": "Dims the whole window behind the search modal. The text colour at 32% (search-handoff)."
      }
    },
    "console": {
      "$note": "The chrome around terminals. Same values in every appearance. The terminal's ANSI palette is not designed.",
      "console": {
        "value": "#15171B",
        "use": "Console pane, console tab strips, terminal background"
      },
      "consoleRule": {
        "value": "#2B2F36",
        "use": "Rules on the console"
      },
      "consoleText": {
        "value": "#E6E8EB",
        "use": "Text on the console, terminal foreground"
      },
      "consoleText2": {
        "value": "#9AA1AB",
        "use": "Secondary text and inactive tabs on the console"
      },
      "needsYouOnConsole": {
        "value": "#F97316",
        "use": "Needs-you glyph on the console"
      },
      "placeholderBarOnConsole": {
        "value": "#2F333A",
        "use": "Placeholder in the targets; not built"
      },
      "tuiInputBorder": {
        "value": "#4A4F57",
        "use": "In the targets only: stands for the TUI's own input box, which Claude Code draws"
      }
    },
    "darkProvisional": {
      "$note": "NOT APPROVED. Taken from the parked 'Night' direction, which Geoff passed over in favour of two-tone. Here so views can be wired to a second appearance; do not ship without review. controlEdge is 2.2:1 on ground and must be lifted to reach 3:1.",
      "ground": {
        "value": "#16181C"
      },
      "pane": {
        "value": "#16181C"
      },
      "selected": {
        "value": "#23262B"
      },
      "rule": {
        "value": "#2B2F36"
      },
      "controlEdge": {
        "value": "#4A4F57"
      },
      "text": {
        "value": "#E6E8EB"
      },
      "text2": {
        "value": "#9AA1AB"
      },
      "needsYou": {
        "value": "#F97316"
      },
      "console": {
        "value": "#0F1114"
      }
    },
    "systemDrawn": {
      "$note": "Appear in the mocks only; the system draws these. Do not implement.",
      "trafficLights": [
        "#FF5F57",
        "#FEBC2E",
        "#28C840"
      ]
    }
  },
  "font": {
    "family": {
      "ui": {
        "swift": "Font.system(size:weight:design: .default)",
        "css": "-apple-system, BlinkMacSystemFont, 'SF Pro Text', system-ui, sans-serif"
      },
      "mono": {
        "swift": "Font.system(size:weight:design: .monospaced)",
        "css": "ui-monospace, 'SF Mono', SFMono-Regular, Menlo, monospace"
      }
    },
    "style": {
      "body": {
        "family": "ui",
        "size": 13,
        "lineHeight": 20,
        "weight": "regular"
      },
      "bodyEmphasis": {
        "family": "ui",
        "size": 13,
        "lineHeight": 20,
        "weight": "semibold"
      },
      "title": {
        "family": "ui",
        "size": 14,
        "lineHeight": 20,
        "weight": "semibold",
        "use": "Pane title, document heading"
      },
      "control": {
        "family": "ui",
        "size": 12,
        "lineHeight": 16,
        "weight": "regular",
        "use": "Buttons, hints"
      },
      "chip": {
        "family": "ui",
        "size": 12,
        "lineHeight": 20,
        "weight": "semibold"
      },
      "sectionLabel": {
        "family": "ui",
        "size": 11,
        "lineHeight": 16,
        "weight": "semibold",
        "tracking": 0.66,
        "textCase": "uppercase"
      },
      "pill": {
        "family": "ui",
        "size": 11,
        "lineHeight": 16,
        "weight": "regular"
      },
      "mono": {
        "family": "mono",
        "size": 12,
        "lineHeight": 19,
        "weight": "regular",
        "use": "Console chrome, file names"
      },
      "monoActiveTab": {
        "family": "mono",
        "size": 12,
        "lineHeight": 19,
        "weight": "medium"
      },
      "monoPath": {
        "family": "mono",
        "size": 11,
        "lineHeight": 20,
        "weight": "regular",
        "use": "Project path under FILES"
      },
      "searchField": {
        "family": "ui",
        "size": 17,
        "lineHeight": 24,
        "weight": "regular",
        "use": "The modal's field. The only new type size."
      }
    }
  },
