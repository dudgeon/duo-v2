  "size": {
    "idlePopover": {
      "$surface": "DB-1",
      "width": 460,
      "anchor": "above the map footer, arrow down, 16 from the map's left edge",
      "padding": {
        "top": 12,
        "horizontal": 8,
        "bottom": 12
      },
      "rowHeight": 26,
      "rowRadius": 6,
      "projectColumnMax": 150,
      "ageColumn": 30,
      "maxHeight": "the map's height less 32; the list scrolls, the heading and key row stay"
    },
    "consoleMessage": {
      "$surface": "DB-3",
      "padding": 24,
      "paddingInHomePane": {
        "vertical": 20,
        "horizontal": 16
      },
      "maxTextWidth": 440,
      "gap": 6,
      "buttonsTop": 8
    },
    "consoleBar": {
      "$surface": "DB-3, DB-4",
      "height": 40,
      "paddingHorizontal": 16,
      "rule": "1 consoleRule above"
    },
    "consoleTabOverflow": {
      "$surface": "DB-4",
      "titleMaxCharacters": 24
    },
    "newTabMenu": {
      "$surface": "DB-4",
      "width": 230,
      "note": "A native menu; the system draws its chrome."
    }
  },
  "reuse": {
    "buttonOnConsole": "1 consoleText2 border, no fill, consoleText label, the standard button's size and radius",
    "groupPillInLists": "1 rule border, radius 9, 11/16 (the thread pill)",
    "unfiledAndArchivedPills": "controlEdge border, as in search",
    "popover": "pane fill, 1 rule border, radius 10, shadow.popover, as the peek"
  },
  "icon": {
    "shellPrompt": {
      "$surface": "DB-4",
      "size": "11 x 9",
      "viewBox": "0 0 12 10",
      "svg": "<path d='M1.5 2 5 5 1.5 8' fill='none' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/><path d='M6.5 8.5h4' fill='none' stroke-width='1.5' stroke-linecap='round'/>",
      "stroke": "consoleText when its tab is selected, consoleText2 otherwise",
      "sfSymbol": "chevron.right (with an underscore drawn beside it); 'apple.terminal' is too detailed at this size"
    },
    "moreTabs": {
      "$surface": "DB-4",
      "viewBox": "0 0 12 10",
      "svg": "<path d='M2 1.5 5.5 5 2 8.5M6.5 1.5 10 5 6.5 8.5' fill='none' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/>",
      "stroke": "consoleText2",
      "sfSymbol": "chevron.right.2"
    },
    "chevronUp": {
      "$surface": "DB-1",
      "note": "The map footer's chevron turns to point up, in text, while the list is open."
    }
